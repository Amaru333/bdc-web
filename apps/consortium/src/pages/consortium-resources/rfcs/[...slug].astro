---
import MarkdownContent from "@components/common/MarkdownContent.astro";
import Directory from "@layouts/Directory.astro";
import { getEntry } from "astro:content";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const [tabSlug, childSlug] = slug.split("/");

const tabEntry = await getEntry("rfcs-api", tabSlug);
if (!tabEntry) return Astro.redirect("/404");

let currentData = tabEntry.data;
const isParent = !childSlug;

if (!isParent) {
  const childMatch = tabEntry.data.children?.find((child) => child.slug === childSlug);
  if (!childMatch) return Astro.redirect("/404");
  currentData = childMatch;
}

const children =
  isParent && tabEntry.data.children?.length
    ? [...tabEntry.data.children]
        .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
        .map((child) => ({
        title: child.name,
        href: `/consortium-resources/rfcs/${tabSlug}/${child.slug}`,
      }))
    : [];
---

<Directory title={currentData.name}>
  <div>
    <h1>{currentData.name}</h1>

    {
      isParent && children.length > 0 ? (
        <div>
          <ul class="usa-list">
            {children.map((child) => (
              <li>
                <a href={child.href} class="usa-link">
                  {child.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <MarkdownContent content={currentData.content} />
      )
    }
  </div>
</Directory>
