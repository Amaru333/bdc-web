---
import MarkdownContent from "@components/common/MarkdownContent.astro";
import Directory from "@layouts/Directory.astro";
import { getEntry } from "astro:content";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");
if (slug.startsWith("fonts/") || slug.startsWith("img/")) {
  return new Response(null, { status: 404 });
}

const [parentSlug, childSlug] = slug.split("/");

const parentEntry = await getEntry("meeting-materials-api", parentSlug);
if (!parentEntry) return Astro.redirect("/404");

let currentData = parentEntry.data;
const isParent = !childSlug;

if (!isParent) {
  const childMatch = parentEntry.data.children?.find((child) => child.slug === childSlug);
  if (!childMatch) return Astro.redirect("/404");
  currentData = childMatch;
}

const year = parentEntry.data.name.match(/\d{4}/)?.[0] ?? parentSlug.match(/^\d{4}$/)?.[0] ?? "";

const children =
  isParent && parentEntry.data.children?.length
    ? parentEntry.data.children.map((child) => ({
        title: child.name,
        href: `/consortium-resources/meeting-materials/${parentSlug}/${child.slug}`,
      }))
    : [];
---

<Directory title={currentData.name}>
  <div>
    <h1>{currentData.name}</h1>

    {
      isParent && children.length > 0 ? (
        <div>
          <p>
            The following meetings were presented throughout {year}. To view materials from a meeting, please click on a
            date below or select the date under the dropdown menu on the left.
          </p>
          <ul class="usa-list">
            {children.map((child) => (
              <li>
                <a href={child.href} class="usa-link">
                  {child.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <MarkdownContent content={currentData.content} />
      )
    }
  </div>
</Directory>
