---
import { ClientRouter } from "astro:transitions";
import SiteAlertList from "@components/layout/SiteAlertList.astro";
import SiteFooter from "@components/layout/SiteFooter.astro";
import { SiteHeader } from "@components/layout/SiteHeader";
import "../styles/global.scss";

interface Props {
  title: string;
  // Pass enableRecaptcha on any page that includes a form.
  // Scopes the reCAPTCHA script to only pages that need it,
  // avoiding unnecessary Google script loading sitewide.
  enableRecaptcha?: boolean;
}

const { title, enableRecaptcha = false } = Astro.props;
const isHomePage = Astro.url.pathname === "/";
const displayTitle = title.includes("BioData Catalyst") ? title : `${title} | BioData Catalyst`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{displayTitle}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
    <ClientRouter />
    {enableRecaptcha && <script src={`https://www.google.com/recaptcha/api.js?render=${import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY}`} async defer />}
    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1;
      }
    </style>
  </head>
  <body data-pagefind-ignore>
    <a class="usa-skipnav" href="#main-content">Skip to main content</a>
    <SiteAlertList isHomePage={isHomePage} />
    <SiteHeader client:only="react" transition:persist />
    <pagefind-modal instance="site-modal" reset-on-close>
      <pagefind-modal-header>
        <pagefind-input></pagefind-input>
      </pagefind-modal-header>
      <pagefind-modal-body>
        <pagefind-summary></pagefind-summary>
        <pagefind-results>
          <Fragment
            set:html={`<script type="text/pagefind-template">
            <li class="pf-result">
              <div class="pf-result-card">
                <div class="pf-result-content">
                  <p class="pf-result-title">
                    <a class="pf-result-link" href="{{ meta.url | default(url) | safeUrl }}">{{ meta.title | default("Untitled") }}</a>
                  </p>
                  <p style="margin: 0;">
                    <span style="display: inline-block; margin-right: 0.5rem; padding: 0.125rem 0.45rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; line-height: 1.2; background: #e7f6fd; color: #005ea2;">News</span>
                    <span style="display: inline-block; padding: 0.125rem 0.45rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; line-height: 1.2; background: #fef0c8; color: #8b4700;">Article</span>
                  </p>
                  {{#if excerpt}}
                  <p class="pf-result-excerpt">{{+ excerpt +}}</p>
                  {{/if}}
                </div>
              </div>
            </li>
          </script>`}
          />
        </pagefind-results>
      </pagefind-modal-body>
      <pagefind-modal-footer>
        <pagefind-keyboard-hints></pagefind-keyboard-hints>
      </pagefind-modal-footer>
    </pagefind-modal>
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      const getSearchModal = () => document.querySelector('pagefind-modal[instance="site-modal"]');

      const openSearchModal = () => {
        const modal = getSearchModal();
        if (!modal || typeof modal.open !== "function") return;
        modal.open();
      };

      const handleSearchModalEnter = (event) => {
        if (event.key !== "Enter" || event.isComposing) return;
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) return;

        const modal = getSearchModal();
        if (!modal?.contains(target)) return;

        const query = target.value.trim();
        if (!query) return;

        event.preventDefault();
        window.location.href = `/search?q=${encodeURIComponent(query)}`;
      };

      window.addEventListener("bdc:open-search-modal", openSearchModal);
      document.addEventListener("keydown", handleSearchModalEnter);
    </script>
  </body>
</html>
