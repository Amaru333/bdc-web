---
import { ClientRouter } from "astro:transitions";
import SiteAlertList from "@components/layout/SiteAlertList.astro";
import SiteFooter from "@components/layout/SiteFooter.astro";
import { SiteHeader } from "@components/layout/SiteHeader";
import "../styles/global.scss";

interface Props {
  title: string;
  // Pass enableRecaptcha on any page that includes a form.
  // Scopes the reCAPTCHA script to only pages that need it,
  // avoiding unnecessary Google script loading sitewide.
  enableRecaptcha?: boolean;
}

const { title, enableRecaptcha = false } = Astro.props;
const isHomePage = Astro.url.pathname === "/";
const displayTitle = title.includes("BioData Catalyst") ? title : `${title} | BioData Catalyst`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{displayTitle}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
    <ClientRouter />
    {enableRecaptcha && <script src={`https://www.google.com/recaptcha/api.js?render=${import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY}`} async defer />}
  </head>
  <body data-pagefind-ignore class="display-flex flex-column minh-viewport">
    <a class="usa-skipnav" href="#main-content">Skip to main content</a>
    <SiteAlertList isHomePage={isHomePage} />
    <SiteHeader client:only="react" transition:persist />
    <pagefind-modal instance="site-modal" reset-on-close>
      <pagefind-modal-header>
        <pagefind-input></pagefind-input>
      </pagefind-modal-header>
      <pagefind-modal-body>
        <pagefind-summary></pagefind-summary>
        <pagefind-results>
          <Fragment
            set:html={`<script type="text/pagefind-template">
            <li class="pf-result">
              <div class="pf-result-card">
                <div class="pf-result-content">
                  <p class="pf-result-title">
                    <a class="pf-result-link" href="{{ meta.url | default(url) | safeUrl }}">{{ meta.title | default("Untitled") }}</a>
                  </p>
                  <p class="margin-0">
                    <span class="display-inline-block margin-right-1 padding-x-1 padding-y-05 radius-pill font-body-2xs text-bold bg-base-lightest text-base-dark">News</span>
                    <span class="display-inline-block padding-x-1 padding-y-05 radius-pill font-body-2xs text-bold bg-base-lightest text-base-dark">Article</span>
                  </p>
                  {{#if excerpt}}
                  <p class="pf-result-excerpt">{{+ excerpt +}}</p>
                  {{/if}}
                </div>
              </div>
            </li>
          </script>`}
          />
        </pagefind-results>
      </pagefind-modal-body>
      <pagefind-modal-footer>
        <pagefind-keyboard-hints></pagefind-keyboard-hints>
      </pagefind-modal-footer>
    </pagefind-modal>
    <main id="main-content" data-pagefind-body class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <script src="../scripts/init-search-modal.ts"></script>
  </body>
</html>
